{
  "name": "firestorm-arena-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "ArenaMatch"
      },
      {
        "name": "QUOTA",
        "class_name": "QuotaMeter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaMatch"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["QuotaMeter"]
    }
  ]
}
