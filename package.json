{
  "name": "game-prototypes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["prototypes/*", "packages/*"],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build:packages": "npm run build --workspaces --if-present",
    "prebuild": "npm run build:packages",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/generate-versions.js && npm run build:packages",
    "typecheck": "tsc --noEmit",
    "fetch:assets": "node scripts/fetch-assets.js",
    "pack:assets": "node scripts/pack-assets.js"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "phaser": "^3.87.0",
    "qrcode": "^1.5.4",
    "trystero": "^0.25.3",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^4.7.0",
    "adm-zip": "^0.6.0",
    "free-tex-packer-cli": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
